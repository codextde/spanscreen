            "state": "translated",
            "value": "Das iPhone hat die Kabelverbindung abgelehnt (%lld)."
          }
        }
      }
    },
    "Turns taps, drags and two-finger scrolls on iPhone into clicks and scrolls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht aus Tippen, Ziehen und Scrollen mit zwei Fingern auf dem iPhone Klicks und Scrollen."
