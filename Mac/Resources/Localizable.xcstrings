    "%@ closed the connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Verbindung beendet."
          }
        }
      }
    },
    "%@ could not be verified. Click Connect to pair it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht verifiziert werden. Klicke auf Verbinden, um es neu zu koppeln."
