    "Spanscreen needs Screen Recording permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanscreen braucht die Berechtigung für Bildschirmaufnahmen."
          }
        }
      }
    },
    "Spanscreen streams the virtual display to your iPhone. Nothing leaves your network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanscreen überträgt den virtuellen Bildschirm auf dein iPhone. Nichts verlässt dein Netzwerk."
          }
        }
      }
    },
    "Starting display…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm wird gestartet …"
