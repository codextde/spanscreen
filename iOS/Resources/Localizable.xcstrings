    "Spanscreen": {
      "shouldTranslate": false
    },
    "Spanscreen %@ by Codext. Free and open source. No account, no tracking: video and input stay on your local network or cable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanscreen %@ von Codext. Kostenlos und Open Source. Kein Konto, kein Tracking: Bild und Eingaben bleiben in deinem lokalen Netzwerk oder am Kabel."
          }
        }
      }
    },
    "Spanscreen for Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanscreen für Mac"
          }
        }
      }
    },
