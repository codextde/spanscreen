      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone"
          }
        }
      }
    },
    "This iPhone becomes a display for the Mac and can control it with touch. You can disconnect at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone wird zum Bildschirm für den Mac und kann ihn per Touch steuern. Du kannst die Verbindung jederzeit trennen."
          }
        }
      }
    },
